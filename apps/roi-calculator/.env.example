# Pipedrive (conta INUBIA). Token pessoal de um utilizador com permissão para criar organizações, pessoas e negócios.
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=inubia
# Opcional: pipeline/etapa/owner onde os negócios de parceria devem entrar (ids numéricos do Pipedrive).
PIPEDRIVE_PIPELINE_ID=
PIPEDRIVE_STAGE_ID=
PIPEDRIVE_OWNER_ID=
PIPEDRIVE_ORG_LABEL_ID=

# Email (SMTP do Google Workspace ou outro).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM="INUBIA <parcerias@inubia.pt>"
MAIL_CC=parcerias@inubia.pt
# Link para o PDF/página do plano de parceiros, incluído no email (opcional).
PARTNER_PLAN_URL=

PORT=3080
# DRY_RUN=1 para demonstrar sem credenciais: regista no terminal em vez de chamar Pipedrive e SMTP.
DRY_RUN=0
