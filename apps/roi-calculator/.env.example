# Pipedrive (conta INUBIA). Token pessoal de um utilizador com permissão para criar organizações, pessoas e negócios.
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=inubia
# Pipeline INUBIA (id 11) na etapa "Diagnóstico Estratégico" (id 74). Owner opcional; por omissão fica o utilizador do token.
PIPEDRIVE_PIPELINE_ID=11
PIPEDRIVE_STAGE_ID=74
PIPEDRIVE_OWNER_ID=
PIPEDRIVE_ORG_LABEL_ID=

# Email (SMTP do Google Workspace ou outro).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM="INUBIA <parcerias@inubia.pt>"
MAIL_CC=parcerias@inubia.pt
# Link para o PDF/página do plano de parceiros, incluído nos emails (opcional). Sem valor, usa PUBLIC_BASE_URL/docs/programa-parceiros-inubia.pdf.
PARTNER_PLAN_URL=
PUBLIC_BASE_URL=https://inubia-roi-capi.vercel.app

# Identificação legal da entidade INUBIA que outorga o contrato de parceria (minuta gerada na adesão).
PARTNER_COMPANY_LEGAL=
PARTNER_COMPANY_NIF=
PARTNER_COMPANY_ADDRESS=
PARTNER_EMAIL=parcerias@inubia.pt
PARTNER_JURISDICTION=Faro

PORT=3080
# DRY_RUN=1 para demonstrar sem credenciais: regista no terminal em vez de chamar Pipedrive e SMTP.
DRY_RUN=0
